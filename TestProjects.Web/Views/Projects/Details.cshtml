@model TestProjects.DAL.Models.Project
@{
    ViewData["Title"] = "Информация о проекте";
}

<h1>@ViewData["Title"]</h1>

<div class="row mt-4">
    <div class="col-md-8">
        <div class="card p-4 shadow-sm bg-white">
            <h3 class="mb-4 text-primary">Детали проекта: @Model.Name</h3>

            <div style="font-size: 1.1rem; line-height: 1.8;">
                <!-- 1. General Project Descriptive Metadata Fields -->
                <p><strong>Название компании заказчика:</strong> @Model.CustomerCompany</p>
                <p><strong>Название компании исполнителя:</strong> @Model.CExecutorCompany</p>
                <p><strong>Дата начала проекта:</strong> @Model.StartDate.ToString("dd.MM.yyyy")</p>
                <p><strong>Дата окончания проекта:</strong> @Model.EndDate.ToString("dd.MM.yyyy")</p>
                <p><strong>Приоритет проекта:</strong> <span class="badge bg-secondary">@Model.Priority</span></p>

                <!-- 2. Conditional Rendering for Project Manager (Loaded via Eager Loading .Include()) -->
                <p>
                    <strong>Руководитель:</strong>
                    @if (Model.ProjectManager != null)
                    {
                        <span class="text-success fw-bold">@Model.ProjectManager.FullName</span> <span class="text-muted">(@Model.ProjectManager.Email)</span>
                    }
                    else
                    {
                        <span class="text-muted">Не назначен</span>
                    }
                </p>

                <!-- 3. Many-to-Many Navigation Property Enumeration (Team Composition) -->
                <div class="mt-3">
                    <strong>Сотрудники проекта:</strong>
                    @if (Model.Employees != null && Model.Employees.Any())
                    {
                        <ul class="list-group mt-2">
                            @foreach (var emp in Model.Employees)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <span>@emp.FullName</span>
                                    <span class="text-muted small">@emp.Email</span>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <span class="text-muted">В команде пока нет сотрудников</span>
                    }
                </div>

                <!-- 4. Asset Retrieval logic: Parsing serialized paths back to individual static links -->
                <div class="mt-4">
                    <strong>Документы проекта:</strong>
                    @if (!string.IsNullOrEmpty(Model.DocumentPaths))
                    {
                        <div class="list-group mt-2">
                            @foreach (var path in Model.DocumentPaths.Split(';'))
                            {
                                if (!string.IsNullOrWhiteSpace(path))
                                {
                                    <a href="@path" target="_blank" class="list-group-item list-group-item-action text-primary">
                                        <i class="bi bi-file-earmark-arrow-down"></i> @System.IO.Path.GetFileName(path)
                                    </a>
                                }
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted small mt-1">Документы не загружены</p>
                    }
                </div>
            </div>

            <!-- 5. Navigation State Controls -->
            <div class="mt-4">
                <a asp-action="List" class="btn btn-secondary">Назад к списку</a>
            </div>
        </div>
    </div>
</div>