@model TestProjects.DAL.Models.Project

<h2>Редактирование проекта: @Model.Name</h2>

<form asp-action="Edit" method="post" enctype="multipart/form-data" class="mt-4">
    <input type="hidden" asp-for="Id" />
    <div class="row">
        <div class="col-md-6">
            <div class="form-group mb-3">
                <label class="form-label">Название проекта</label>
                <input asp-for="Name" class="form-control" required />
            </div>

            <div class="form-group mb-3">
                <label class="form-label">Компания-заказчик</label>
                <input asp-for="CustomerCompany" class="form-control" required />
            </div>

            <div class="form-group mb-3">
                <label class="form-label">Компания-исполнитель</label>
                <input asp-for="CExecutorCompany" class="form-control" required />
            </div>

            <div class="form-group mb-3">
                <label class="form-label">Дата начала</label>
                <input asp-for="StartDate" type="date" class="form-control" required />
            </div>

            <div class="form-group mb-3">
                <label class="form-label">Дата окончания</label>
                <input asp-for="EndDate" type="date" class="form-control" required />
            </div>

            <div class="form-group mb-3">
                <label class="form-label">Приоритет</label>
                <input asp-for="Priority" type="number" class="form-control" required />
            </div>
        </div>
        <div class="col-md-6">

            <!-- 1. Project Manager Selection (One-to-Many Relationship Lookup) -->
            <div class="form-group mb-3">
                <label class="form-label">Руководитель проекта</label>
                <select asp-for="ProjectManagerId" class="form-select">
                    <option value="">-- Не выбран --</option>
                    @foreach (var emp in ViewBag.AllEmployees)
                    {
                        <option value="@emp.Id">@emp.FullName</option>
                    }
                </select>
            </div>

            <!-- 2. Interactive Search Area for Team Participants -->
            <div class="form-group mb-3">
                <label class="form-label fw-bold">Состав исполнителей проекта</label>
                <p class="form-text text-muted small mb-2">Начните вводить ФИО сотрудника и нажмите «Добавить»:</p>

                <div class="input-group">
                    <input type="text" id="employee-search-input" list="employees-list" class="form-control" placeholder="Поиск по ФИО..." autocomplete="off">
                    <button type="button" id="add-employee-btn" class="btn btn-primary">Добавить</button>
                </div>

                <!-- Autocomplete pool populated from the backend context -->
                <datalist id="employees-list">
                    @if (ViewBag.AllEmployees != null)
                    {
                        @foreach (var emp in ViewBag.AllEmployees)
                        {
                            <option value="@emp.FullName" data-id="@emp.Id" data-email="@emp.Email"></option>
                        }
                    }
                </datalist>
            </div>

            <!-- 3. Many-to-Many Relationship Collection Tracking Table -->
            <div class="table-responsive mb-4">
                <table class="table table-sm table-bordered table-striped align-middle" id="selected-employees-table">
                    <thead class="table-light">
                        <tr>
                            <th>ФИО сотрудника</th>
                            <th>Email</th>
                            <th style="width: 50px; text-align: center;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- Pre-populate the table with current project participants fetched via eager loading -->
                        @if (Model?.Employees != null)
                        {
                            @foreach (var emp in Model.Employees)
                            {
                                <tr id="emp-row-@emp.Id">
                                    <td>
                                        @emp.FullName
                                        <!-- Hidden primitive array element for seamless model binding payload collection -->
                                        <input type="hidden" name="selectedEmployeeIds" value="@emp.Id" />
                                    </td>
                                    <td>@emp.Email</td>
                                    <td class="text-center">
                                        <!-- Client-side row detachment utilizing vanilla JavaScript DOM methods -->
                                        <button type="button" class="btn btn-danger btn-sm" onclick="this.closest('tr').remove();">Удалить</button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <!-- 4. Display Existing Attached Files (Serialized String Deserialization) -->
            <div class="mb-3">
                <label class="form-label d-block fw-bold">Уже загруженные документы:</label>
                @if (!string.IsNullOrEmpty(Model.DocumentPaths))
                {
                    <ul class="list-group mb-2">
                        @foreach (var path in Model.DocumentPaths.Split(';'))
                        {
                            if (!string.IsNullOrWhiteSpace(path))
                            {
                                <li class="list-group-item small bg-light">
                                    @System.IO.Path.GetFileName(path)
                                </li>
                            }
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted small">Документов пока нет</p>
                }
            </div>

            <!-- 5. Multiple File Attachment Payload Input Trigger -->
            <div class="form-group mb-3">
                <label class="form-label fw-bold text-primary">Добавить новые документы:</label>
                <input type="file" name="newFiles" class="form-control" multiple />
            </div>
        </div>
    </div>

    <!-- 6. Form Lifecycle Submission Controls -->
    <div class="mt-4">
        <button type="submit" class="btn btn-success">Сохранить изменения</button>
        <a asp-action="List" class="btn btn-secondary ms-2">Назад к списку</a>
    </div>
</form>

@section Scripts
{
    <script src="~/js/project-edit.js" asp-append-version="true"></script>
}


