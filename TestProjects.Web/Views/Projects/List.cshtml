@model IEnumerable<TestProjects.DAL.Models.Project>
@{
    ViewData["Title"] = "Список проектов";
    int index = 1;
}

<h1>@ViewData["Title"]</h1>

<!-- 1. Server-side Querying Control Panel: Dispatches filter parameters-->
<form method="get" asp-action="List" class="bg-light p-3 rounded mb-4">
    <div class="row g-3 align-items-end">
        <!-- Date range parameters mapping -->
        <div class="col-md-3">
            <label class="form-label small fw-bold">Дата начала (С):</label>
            <input type="date" name="startDateFrom" value="@ViewBag.StartDateFrom" class="form-control form-control-sm" />
        </div>
        <div class="col-md-3">
            <label class="form-label small fw-bold">Дата начала (По):</label>
            <input type="date" name="startDateTo" value="@ViewBag.StartDateTo" class="form-control form-control-sm" />
        </div>

        <!-- Metric scalar sorting constraint -->
        <div class="col-md-2">
            <label class="form-label small fw-bold">Приоритет:</label>
            <input type="number" name="priority" value="@ViewBag.Priority" class="form-control form-control-sm" placeholder="Все" />
        </div>

        <!-- State Retention: Property key mapping selection -->
        <div class="col-md-2">
            <label class="form-label small fw-bold">Сортировать по:</label>
            <select name="sortBy" class="form-select form-select-sm">
                <option value="name" selected="@(ViewBag.SortBy == "name")">Названию</option>
                <option value="startdate" selected="@(ViewBag.SortBy == "startdate")">Дате начала</option>
                <option value="enddate" selected="@(ViewBag.SortBy == "enddate")">Дате окончания</option>
                <option value="priority" selected="@(ViewBag.SortBy == "priority")">Приоритету</option>
            </select>
        </div>

        <!-- Sorting sequence order selector -->
        <div class="col-md-2">
            <label class="form-label small fw-bold">Порядок:</label>
            <select name="sortOrder" class="form-select form-select-sm">
                <option value="asc" selected="@(ViewBag.SortOrder == "asc")">Возрастание</option>
                <option value="desc" selected="@(ViewBag.SortOrder == "desc")">Убывание</option>
            </select>
        </div>
    </div>

    <!-- UI lifecycle control hooks -->
    <div class="mt-3 d-flex gap-2 justify-content-end">
        <a asp-action="List" class="btn btn-secondary btn-sm">Сбросить</a>
        <button type="submit" class="btn btn-primary btn-sm">Применить фильтры</button>
    </div>
</form>

<div class="mt-3 mb-3 d-flex justify-content-between align-items-center">
    <a asp-controller="Projects" asp-action="Create" class="btn btn-success">
        + Добавить проект
    </a>
</div>

<!-- 2. Paginated Data Presentation Layer Grid -->
<table class="table table-striped mt-4">
    <thead>
        <tr>
            <th>№</th>
            <th>Название проекта</th>
            <th>Дата окончания</th>
            <th>Приоритет</th>
        </tr>
    </thead>
    <tbody>
        <!-- Empty collection evaluation via LINQ extension methods -->
        @if (Model != null && Model.Count() > 0)
        {
            foreach (var project in Model)
            {
                <tr>
                    <td>@index</td>
                    <td>@project.Name</td>
                    <td>@project.EndDate.ToString("dd.MM.yyyy")</td>
                    <td>@project.Priority</td>
                    <td class="d-flex gap-2">
                        <a asp-controller="Projects" asp-action="Details" asp-route-id="@project.Id" class="btn btn-primary btn-sm">Просмотреть</a>
                        <a asp-controller="Projects" asp-action="Edit" asp-route-id="@project.Id" class="btn btn-primary btn-sm">Редактировать</a>

                        <form asp-action="Delete" method="post" onsubmit="return confirm('Вы уверены, что хотите удалить проект?');">
                            <input type="hidden" name="id" value="@project.Id" />
                            <button type="submit" class="btn btn-danger btn-sm">Удалить</button>
                        </form>
                    </td>
                </tr>
                index++;
            }
        }
        else
        {
            <tr>
                <td colspan="4" class="text-center text-muted">Проекты не найдены</td>
            </tr>
        }
    </tbody>
</table>