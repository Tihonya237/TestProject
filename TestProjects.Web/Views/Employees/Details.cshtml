@model TestProjects.DAL.Models.Employee

@{
    ViewData["Title"] = "Информация о сотруднике";
}

<h1>@ViewData["Title"]</h1>

<div class="row mt-4">
    <div class="col-md-8">
        <div class="card p-4 shadow-sm bg-white">
            <div class="form-group mb-3" style="font-size: 1.1rem; line-height: 1.6;">
                <p class="form-label"><strong>ФИО сотрудника:</strong> @Model.FullName</p>
                <p class="form-label"><strong>ID сотрудника:</strong> @Model.Id</p>
                <p class="form-label"><strong>Email сотрудника:</strong> @Model.Email</p>
            </div>

            <div class="d-flex align-items-center mt-4 gap-2">
                <a asp-action="List" class="btn btn-secondary">Назад к списку</a>
            </div>
        </div>
    </div>
</div>

