@model IEnumerable<TestProjects.DAL.Models.Employee>

@{
    ViewData["Title"] = "Список сотрудников";
    int index = 1;
}

<h1>@ViewData["Title"]</h1>
<div class="mt-3 mb-3 d-flex justify-content-between align-items-center">
    <a asp-controller="Employees" asp-action="Create" class="btn btn-success">+ Добавить сотрудника</a>

    <form asp-action="List" method="get" class="d-flex gap-2">
        <input type="text"
               name="searchString"
               value="@ViewBag.CurrentFilter"
               class="form-control"
               placeholder="Поиск по ФИО или Email..." />
        <button type="submit" class="btn btn-primary">Найти</button>

        @if (!string.IsNullOrEmpty(ViewBag.CurrentFilter))
        {
            <a asp-action="List" class="btn btn-secondary">Сбросить</a>
        }
    </form>
</div>

<table class="table table-striped table-hover mt-4">
    <thead>
        <tr>
            <th>№</th>
            <th>ФИО</th>
            <th>Email</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Count() > 0)
        {
            @foreach (var employee in Model)
            {
                <tr>
                    <td>@index</td>
                    <td>@employee.FullName</td>
                    <td>@employee.Email</td>
                    <td class="d-flex gap-2">
                        <a asp-controller="Employees" asp-action="Details" asp-route-id="@employee.Id" class="btn btn-primary btn-sm">О сотруднике</a>
                        <a asp-controller="Employees" asp-action="Edit" asp-route-id="@employee.Id" class="btn btn-primary btn-sm">Редактировать</a>
                        <form asp-action="Delete" asp-route-id="@employee.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Вы уверены, что хотите удалить сотрудника?');">Удалить</button>
                        </form>
                    </td>
                </tr>
                index++;
            }
        }
        else
        {
            <tr>
                <td colspan="4" class="text-center text-muted">Сотрудники не найдены</td>
            </tr>
        }
    </tbody>
</table>


